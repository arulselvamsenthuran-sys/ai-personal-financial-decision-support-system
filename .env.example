# ==================================================
# AI-Powered Personal Financial Decision Support System
# Environment Configuration
# ==================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ==================================================

# ---- PostgreSQL Database ----
POSTGRES_USER=findev
POSTGRES_PASSWORD=findev_local_password
POSTGRES_DB=finance_support
POSTGRES_PORT=5432

# SQLAlchemy connection string (psycopg v3)
DATABASE_URL=postgresql+psycopg://findev:findev_local_password@localhost:5432/finance_support

# ---- FastAPI Backend ----
API_HOST=0.0.0.0
API_PORT=8000

# ---- Frontend ----
# The URL the React frontend uses to reach the backend API
FRONTEND_API_URL=http://localhost:8000

# ---- Session & Cookie Security ----
# In production with HTTPS, set SESSION_COOKIE_SECURE=true
SESSION_COOKIE_NAME=session_id
SESSION_MAX_AGE_SECONDS=604800
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# ---- OAuth 2.0 Credentials ----
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback/google

FACEBOOK_CLIENT_ID=your_facebook_app_id
FACEBOOK_CLIENT_SECRET=your_facebook_app_secret
FACEBOOK_REDIRECT_URI=http://localhost:5173/auth/callback/facebook

OAUTH_STATE_SECRET=change_this_to_a_random_secret_in_production

# ---- LLM / AI Explanation Layer (Phase 13) ----
# Provider: "gemini" (production/free-tier), "mock" (deterministic test), or "none" (disabled)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-flash-latest
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.1


